{
  "rules": {
    ".read": false,
    ".write": false,
    "ranking": {
      "$diff": {
        ".read": "$diff.matches(/^d[0-5]$/)",
        ".indexOn": [
          "score"
        ],
        "$id": {
          ".write": "$diff.matches(/^d[0-5]$/) && $id.matches(/^[ad][a-z0-9]{15,24}$/) && newData.exists() && (!data.exists() || newData.child('score').val() > data.child('score').val())",
          ".validate": "newData.hasChildren(['name', 'character', 'wave', 'won', 'kills', 'level', 'platform', 'score', 'createdAt'])",
          "name": {
            ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 16 && newData.val().matches(/^[^<>&{}]+$/)"
          },
          "character": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 29"
          },
          "wave": {
            ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 9999 && (newData.val() <= 20 || ($diff === 'd4' && newData.val() <= 35) || $diff === 'd5')"
          },
          "won": {
            ".validate": "newData.isBoolean() && (newData.val() === false || ($diff.matches(/^d[0-3]$/) && newData.parent().child('wave').val() === 20) || ($diff === 'd4' && newData.parent().child('wave').val() === 35))"
          },
          "kills": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 999999"
          },
          "level": {
            ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 999"
          },
          "platform": {
            ".validate": "newData.val() === 'web' || newData.val() === 'android'"
          },
          "score": {
            ".validate": "newData.isNumber() && ((newData.parent().child('won').val() === true && newData.val() === 100000000 + newData.parent().child('wave').val() * 1000000 + newData.parent().child('kills').val()) || (newData.parent().child('won').val() === false && newData.val() === newData.parent().child('wave').val() * 1000000 + newData.parent().child('kills').val()))"
          },
          "createdAt": {
            ".validate": "newData.isNumber() && newData.val() <= now"
          },
          "$other": {
            ".validate": false
          },
          "b": {
            ".validate": "newData.isString() && newData.val().length <= 1000"
          }
        }
      }
    },
    "daily": {
      "$day": {
        ".read": "$day.matches(/^20[0-9][0-9]-[01][0-9]-[0-3][0-9]$/)",
        ".indexOn": [
          "score"
        ],
        "$id": {
          ".write": "$day.matches(/^20[0-9][0-9]-[01][0-9]-[0-3][0-9]$/) && $id.matches(/^[ad][a-z0-9]{15,24}$/) && newData.exists() && (!data.exists() || newData.child('score').val() > data.child('score').val())",
          ".validate": "newData.hasChildren(['name', 'character', 'wave', 'won', 'kills', 'level', 'platform', 'score', 'createdAt'])",
          "name": {
            ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 16 && newData.val().matches(/^[^<>&{}]+$/)"
          },
          "character": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 29"
          },
          "wave": {
            ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 15"
          },
          "won": {
            ".validate": "newData.isBoolean() && (newData.val() === false || newData.parent().child('wave').val() === 15)"
          },
          "kills": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 999999"
          },
          "level": {
            ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 999"
          },
          "platform": {
            ".validate": "newData.val() === 'web' || newData.val() === 'android'"
          },
          "score": {
            ".validate": "newData.isNumber() && ((newData.parent().child('won').val() === true && newData.val() === 100000000 + newData.parent().child('wave').val() * 1000000 + newData.parent().child('kills').val()) || (newData.parent().child('won').val() === false && newData.val() === newData.parent().child('wave').val() * 1000000 + newData.parent().child('kills').val()))"
          },
          "createdAt": {
            ".validate": "newData.isNumber() && newData.val() <= now"
          },
          "$other": {
            ".validate": false
          },
          "b": {
            ".validate": "newData.isString() && newData.val().length <= 1000"
          }
        }
      }
    },
    "rooms": {
      ".read": true,
      "$code": {
        ".write": "$code.matches(/^[A-Z0-9]{4}$/)",
        "h": {
          "meta": {
            ".validate": "newData.hasChildren(['host', 'st'])",
            "host": {
              ".validate": "newData.isString() && newData.val().length <= 20"
            },
            "diff": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 3"
            },
            "st": {
              ".validate": "newData.val() === 'lobby' || newData.val() === 'game' || newData.val() === 'closed'"
            },
            "ts": {
              ".validate": "newData.isNumber()"
            },
            "hb": {
              ".validate": "newData.isNumber()"
            },
            "v": {
              ".validate": "newData.isNumber()"
            },
            "$other": {
              ".validate": false
            },
            "mode": {
              ".validate": "newData.val() === 'coop' || newData.val() === 'pvp'"
            }
          },
          "roster": {
            "$pid": {
              ".validate": "$pid.length <= 20 && newData.hasChildren(['n', 'c'])",
              "n": {
                ".validate": "newData.isString() && newData.val().length <= 16"
              },
              "c": {
                ".validate": "newData.isNumber()"
              },
              "r": {
                ".validate": "newData.isBoolean()"
              },
              "o": {
                ".validate": "newData.isNumber()"
              },
              "k": {
                ".validate": "newData.isNumber()"
              },
              "$other": {
                ".validate": false
              },
              "p": {
                ".validate": "newData.isString() && newData.val().length <= 20"
              }
            }
          },
          "o": {
            "$pid": {
              ".validate": "newData.isString() && newData.val().length <= 20000"
            }
          },
          "start": {
            ".validate": "newData.isString() && newData.val().length <= 4000"
          },
          "snap": {
            ".validate": "newData.isString() && newData.val().length <= 60000"
          },
          "ps": {
            "$pid": {
              ".validate": "newData.isString() && newData.val().length <= 8000"
            }
          },
          "$other": {
            ".validate": false
          },
          "duel": {
            ".validate": "newData.isString() && newData.val().length <= 60000"
          }
        },
        "g": {
          "$pid": {
            ".validate": "$pid.length <= 20",
            "n": {
              ".validate": "newData.isString() && newData.val().length <= 16"
            },
            "c": {
              ".validate": "newData.isNumber()"
            },
            "r": {
              ".validate": "newData.isBoolean()"
            },
            "hb": {
              ".validate": "newData.isNumber()"
            },
            "a": {
              ".validate": "newData.isString() && newData.val().length <= 20000"
            },
            "in": {
              ".validate": "newData.isString() && newData.val().length <= 500"
            },
            "rd": {
              ".validate": "newData.isString() && newData.val().length <= 12000"
            },
            "$other": {
              ".validate": false
            },
            "pv": {
              ".validate": "newData.isString() && newData.val().length <= 20"
            }
          }
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "users": {
      "$u": {
        ".read": true,
        ".write": "!data.exists() && newData.exists()",
        ".validate": "$u.matches(/^[a-z0-9_]{3,16}$/) && newData.hasChildren(['n', 'c'])",
        "n": {
          ".validate": "newData.isString() && newData.val().toLowerCase() === $u"
        },
        "c": {
          ".validate": "newData.isNumber() && newData.val() <= now"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "saves": {
      "$k": {
        ".read": true,
        ".write": "$k.matches(/^[0-9a-f]{64}$/)",
        ".validate": "newData.hasChildren(['p', 'u', 'n'])",
        "p": {
          ".validate": "newData.isString() && newData.val().length <= 30000"
        },
        "u": {
          ".validate": "newData.isNumber() && newData.val() <= now"
        },
        "n": {
          ".validate": "newData.isString() && newData.val().length <= 16"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "polls": {
      ".read": true
    },
    "votes": {
      "$poll": {
        ".read": true,
        "$voter": {
          ".write": "$poll.matches(/^[a-z0-9_]{2,40}$/) && $voter.matches(/^[a-z0-9]{8,40}$/)",
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 9"
        }
      }
    },
    "reports": {
      "$id": {
        ".write": "!data.exists() && newData.exists()",
        ".validate": "newData.hasChildren(['t', 'm', 'v', 'pf', 'ts'])",
        "t": {
          ".validate": "newData.val() === 'bug' || newData.val() === 'ideia'"
        },
        "m": {
          ".validate": "newData.isString() && newData.val().length >= 5 && newData.val().length <= 1000"
        },
        "n": {
          ".validate": "newData.isString() && newData.val().length <= 16"
        },
        "v": {
          ".validate": "newData.isString() && newData.val().length <= 10"
        },
        "pf": {
          ".validate": "newData.isString() && newData.val().length <= 10"
        },
        "ctx": {
          ".validate": "newData.isString() && newData.val().length <= 300"
        },
        "ua": {
          ".validate": "newData.isString() && newData.val().length <= 200"
        },
        "ts": {
          ".validate": "newData.isNumber() && newData.val() <= now"
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
